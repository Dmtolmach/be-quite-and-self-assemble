diff --git a/src/monet/README.md b/src/monet/README.md
new file mode 100644
index 0000000..7ce9c17
--- /dev/null
+++ b/src/monet/README.md
@@ -0,0 +1,13 @@
+# Monetization adapters (off)
+
+The school version of the app has **no monetization**: `python3 build.py` writes `docs/` without any adapter, and `MONET.hook()` / `MONET.offer()` in `src/app/20f-monetization.js` do nothing.
+
+This folder is the place for a **separate** build for web-game portals, if one is ever wanted:
+
+```
+python3 build.py --monet src/monet/example-adapter.js --out build-portal/index.html
+```
+
+`--monet` refuses to write into `docs/`. The adapter sets `MONET.adapter = { gameStart, gameEnd, share, offer }`; each is optional. Hooks never fire in class mode, class battles, the guided first game, or when a teacher has unlocked everything.
+
+`example-adapter.js` only logs to the console. A real adapter would load a portal SDK, which makes network requests, so such a build no longer matches the privacy note in the app: change that text in the portal build too.
diff --git a/src/monet/example-adapter.js b/src/monet/example-adapter.js
new file mode 100644
index 0000000..7b1e2ac
--- /dev/null
+++ b/src/monet/example-adapter.js
@@ -0,0 +1,9 @@
+  // Example monetization adapter: it only writes to the browser console. It loads no SDK and makes no network requests.
+  // Copy this file for a real portal build (e.g. a web-game portal's ad SDK) and replace the console lines with the SDK calls.
+  // It is pasted inside the app script, so it can use MONET, T(), $() and the rest; it is never part of the school build.
+  MONET.adapter = {
+    gameStart(info) { console.log('[monet] gameStart', info); },
+    gameEnd(info) { console.log('[monet] gameEnd (natural break)', info); },
+    share(info) { console.log('[monet] share', info); },
+    offer(kind, info) { console.log('[monet] offer', kind, info); return false; }, // return true (or a Promise of true) after a finished rewarded ad
+  };
